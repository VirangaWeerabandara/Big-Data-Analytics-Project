# Copy to .env with `make env` — every `change-me` is replaced by a random secret.
# .env is git-ignored; never commit real values.

# ---------------------------------------------------------------- simulated clock
# Real seconds per simulated day (300 = 1 sim day every 5 real minutes).
SIM_DAY_SECONDS=300
# Simulated calendar date the clock starts from on a fresh stack.
SIM_START_DATE=2026-01-01
# How often long-running components re-read the shared clock anchor (real seconds).
SIM_CLOCK_REFRESH_SECONDS=30
LOG_LEVEL=INFO

# ------------------------------------------------------------------------ Kafka
# KRaft cluster id (not a secret; any base64 UUID works).
KAFKA_CLUSTER_ID=wZ3nq4XfTmSb1vK8cL2o9A
TOPIC_VITALS=vitals.raw
TOPIC_LABS=labs.raw
TOPIC_ALERTS=alerts.patient
TOPIC_DEADLETTER=deadletter
VITALS_PARTITIONS=6
LABS_PARTITIONS=3
ALERTS_PARTITIONS=3

# --------------------------------------------------------------------- Postgres
POSTGRES_SUPERUSER_PASSWORD=change-me
WARD_DB_PASSWORD=change-me
AIRFLOW_DB_PASSWORD=change-me
GRAFANA_DB_PASSWORD=change-me

# ---------------------------------------------------------------------- Airflow
# UI login: admin / AIRFLOW_ADMIN_PASSWORD
AIRFLOW_ADMIN_PASSWORD=change-me
AIRFLOW_FERNET_KEY=change-me
AIRFLOW_JWT_SECRET=change-me
AIRFLOW_API_SECRET_KEY=change-me

# ---------------------------------------------------------------------- Grafana
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me

# ------------------------------------------------- host ports (127.0.0.1 only)
POSTGRES_HOST_PORT=5432
KAFKA_HOST_PORT=9094
AIRFLOW_HOST_PORT=8080
API_HOST_PORT=8000
PROMETHEUS_HOST_PORT=9090
GRAFANA_HOST_PORT=3000
SPARK_UI_HOST_PORT=4040
